# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# Durable Object Authentication
# ============================================
# Shared secret key for POST endpoint authentication
# Generate with: openssl rand -hex 32
# IMPORTANT: Keep this secret! Use different keys for dev/staging/production
DO_SECRET_KEY=your_random_secret_key_here_minimum_32_chars

# ============================================
# Supabase Configuration
# ============================================
# Your Supabase project URL
# Find at: Dashboard > Settings > API > Project URL
# Format: https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public/publishable key for JWT validation
# Find at: Dashboard > Settings > API > Project API keys
# This is intentionally public and safe to expose
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (OPTIONAL) Legacy HS256 secret for old Supabase projects
# Only needed if your project uses HS256 instead of RS256/ES256
# NOT RECOMMENDED for new projects
# SUPABASE_JWT_SECRET=your_jwt_secret_here

# ============================================
# Wrangler Configuration
# ============================================
# These are set automatically by wrangler when you run:
#   wrangler secret put DO_SECRET_KEY
#   wrangler secret put SUPABASE_URL
#   wrangler secret put SUPABASE_PUBLISHABLE_KEY
#
# For local development, add secrets to .wrangler/state/v3/kv:
#   npm run dev:secret DO_SECRET_KEY "..."
#   npm run dev:secret SUPABASE_URL "..."
#   npm run dev:secret SUPABASE_PUBLISHABLE_KEY "..."
